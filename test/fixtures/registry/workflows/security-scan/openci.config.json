{
  "defaults": {
    "provider": "glm",
    "runtime": "script",
    "runner": "self-hosted-a8"
  },
  "detect": {
    "defaultBranch": true
  },
  "providerModes": {
    "glm": {
      "runtime": "script",
      "script": {
        "env": {
          "GLM_API_KEY": "${{ secrets.GLM_API_KEY }}"
        },
        "run": "node scripts/run-provider.js glm"
      }
    }
  },
  "runners": {
    "self-hosted-a8": {
      "runsOn": ["self-hosted", "linux", "x64", "a8"]
    }
  },
  "substitutions": {
    "TRIGGER_EVENT": {
      "_default": "pull_request"
    },
    "TARGET_BRANCH": {
      "_default": "main",
      "_detect": "defaultBranch"
    }
  }
}
