{
  "detect": {
    "defaultBranch": true
  },
  "defaults": {
    "provider": "claude",
    "runtime": "action",
    "runner": "github-ubuntu"
  },
  "providerModes": {
    "claude": {
      "runtime": "action"
    },
    "codex": {
      "runtime": "action"
    }
  },
  "runners": {
    "github-ubuntu": {
      "runsOn": "ubuntu-latest"
    }
  },
  "substitutions": {
    "TARGET_BRANCH": {
      "_default": "main",
      "_detect": "defaultBranch"
    }
  }
}
