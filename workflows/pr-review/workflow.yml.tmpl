name: Pull Request Review

on:
  {{TRIGGER_EVENT}}:
    branches: [{{TARGET_BRANCH}}]

jobs:
  review:
    runs-on: {{RUNS_ON}}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '{{NODE_VERSION}}'
      - run: {{INSTALL_CMD}}
      - run: {{VALIDATION_CMD}}
      {{PROVIDER_STEP}}
