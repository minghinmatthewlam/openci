{
  "name": "security-scan",
  "displayName": "Security Scan",
  "description": "Scan pull requests for security vulnerabilities, unsafe patterns, and secret leaks.",
  "version": "1.0.0",
  "author": "openci",
  "tags": ["security", "pull-request", "review"],
  "provider": ["glm"],
  "runtimes": ["script"],
  "runners": ["self-hosted-a8"],
  "defaultRuntime": "script",
  "defaultRunner": "self-hosted-a8",
  "smart": true,
  "requiredSecrets": {
    "glm": ["GLM_API_KEY"]
  },
  "triggers": ["pull_request"],
  "stacks": ["any"],
  "minGitHubActionsVersion": null,
  "repository": "minghinmatthewlam/openci",
  "publishedAt": "2026-03-09"
}
