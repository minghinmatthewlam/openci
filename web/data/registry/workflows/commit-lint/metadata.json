{
  "name": "commit-lint",
  "displayName": "Commit Lint",
  "description": "Review commit messages and PR descriptions for clarity and consistency.",
  "version": "1.0.0",
  "author": "openci",
  "tags": ["commit", "pull-request", "copy-editing"],
  "provider": ["claude", "codex"],
  "smart": true,
  "requiredSecrets": {
    "claude": ["ANTHROPIC_API_KEY"],
    "codex": ["OPENAI_API_KEY"]
  },
  "triggers": ["pull_request"],
  "stacks": ["any"],
  "minGitHubActionsVersion": null,
  "repository": "openci/workflows",
  "publishedAt": "2026-03-09"
}
